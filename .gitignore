* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #f5f5f5;
  background: #0d1117;
  line-height: 1.5;
  font-weight: 500;
  color-scheme: dark;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  background:
    radial-gradient(circle at top, rgba(143, 92, 255, 0.18), transparent 20%),
    linear-gradient(135deg, #091018, #111827 58%, #0d1117);
}

body {
  min-height: 100vh;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  padding: 18px 20px;
  box-shadow: 0 25px 50px rgba(15, 23, 42, 0.25);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #8b5cf6, #f472b6);
  font-weight: 800;
  color: white;
  box-shadow: 0 12px 25px rgba(139, 92, 246, 0.45);
}

.eyebrow,
.section-label {
  margin: 0;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #a5b4fc;
}

.topbar h1,
.preview-header h2 {
  margin: 4px 0 0;
  font-size: clamp(1.15rem, 2vw, 1.8rem);
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.project-name-input {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 10px 12px;
  color: white;
  min-width: 180px;
}

.primary-button,
.secondary-button,
.tool-button {
  border: 1px solid transparent;
  border-radius: 12px;
  padding: 10px 14px;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-button:hover,
.secondary-button:hover,
.tool-button:hover {
  transform: translateY(-1px);
}

.primary-button {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: white;
  box-shadow: 0 10px 20px rgba(232, 121, 249, 0.35);
}

.secondary-button {
  background: rgba(148, 163, 184, 0.08);
  border-color: rgba(148, 163, 184, 0.18);
  color: white;
}

.primary-fill {
  background: linear-gradient(135deg, #14b8a6, #3b82f6);
  color: white;
  width: 100%;
}

.workspace {
  display: flex;
  gap: 18px;
  flex: 1;
  min-height: 0;
}

.panel {
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 26px;
  padding: 18px;
  box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
}

.sidebar {
  width: 230px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.panel-block {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.tool-button {
  background: rgba(15, 23, 42, 0.9);
  border-color: rgba(148, 163, 184, 0.16);
  color: #e2e8f0;
  text-align: left;
}

.tool-button.active {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(236, 72, 153, 0.18));
  border-color: rgba(196, 181, 253, 0.4);
}

.studio-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-width: 0;
}

.preview-header,
.timeline-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.preview-header,
.timeline-panel,
.stage-wrap {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  padding: 18px;
}

.preview-stage {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 470px;
  border-radius: 22px;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(17, 24, 39, 1));
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.video-preview,
.video-placeholder {
  width: 100%;
  height: 100%;
  min-height: 470px;
}

.video-preview {
  display: block;
  object-fit: cover;
  background: #0b1020;
}

.video-placeholder {
  display: grid;
  place-items: center;
  text-align: center;
  color: rgba(226, 232, 240, 0.7);
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(2, 6, 23, 1));
}

.placeholder-icon {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(148, 163, 184, 0.12);
  border: 1px solid rgba(148, 163, 184, 0.2);
  font-size: 2rem;
}

.text-overlay {
  position: absolute;
  transform: translate(-50%, -50%);
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-shadow: 0 6px 18px rgba(15, 23, 42, 0.7);
  white-space: nowrap;
  user-select: none;
}

.timeline-panel {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.timeline-items {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
}

.timeline-item {
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(148, 163, 184, 0.18);
  color: #e5e7eb;
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
}

.timeline-item.active {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.35), rgba(59, 130, 246, 0.25));
  border-color: rgba(196, 181, 253, 0.45);
}

.timeline-item-name {
  font-weight: 700;
}

.trim-panel {
  display: grid;
  gap: 12px;
  margin-top: 10px;
}

.trim-panel label,
.panel-block label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #cbd5e1;
}

input[type='range'] {
  width: 100%;
}

input[type='color'] {
  width: 100%;
  min-height: 40px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 10px;
  background: transparent;
}

input,
select {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  color: white;
  padding: 10px 12px;
}

.full-width {
  width: 100%;
}

@media (max-width: 980px) {
  .workspace {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .toolbar-actions {
    flex-wrap: wrap;
  }
}
